*.pfx
*.pkey
*.keystore
*.jks
*.kdbx
*.secret
*.secrets
secrets.*
*.token
*.tokens
*.passwd
password*
passphrase*
*.gpg
*.asc
*.age
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa
id_ecdsa
id_ecdsa.pub
