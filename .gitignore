# pnpm-lock.yaml

# ============================ 8. RECOVERY / REMOVAL ============================
# If you ever staged a private file by accident, remove it from tracking
# (keeps the local file) with:
#     git rm --cached <file>
# then commit. The patterns above will block it from future commits.
# For files already in history, use `git filter-repo --path <file> --invert-paths`
# and then ROTATE any exposed keys.
